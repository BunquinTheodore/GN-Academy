# ── Firebase web app config (Project settings → General → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (Project settings → Service accounts → Generate new private key)
# FIREBASE_ADMIN_PRIVATE_KEY: paste the full key with literal \n for newlines, wrapped in double quotes:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (API Keys)
RESEND_API_KEY=

# ── App
# Random long string used to hash IP addresses for rate limiting. Generate once, never change.
IP_HASH_SALT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Analytics (optional; both must be set or analytics stays off)
# Any cookieless provider exposing a track(name, props) global. Umami Cloud's
# free tier is the assumed default; Plausible and Counter.dev share the shape.
# Cookieless is required — a cookie would mean a consent banner between a
# first-time visitor and the free test.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# ── Payments (optional; a channel appears only when BOTH its name and number
# are set). No gateway: learners send GCash/Maya and type the receipt's
# reference number, staff confirm from /admin/enrollments. Leave blank and the
# enroll page says the account is published with the first cohort.
NEXT_PUBLIC_PAYMENT_GCASH_NAME=
NEXT_PUBLIC_PAYMENT_GCASH_NUMBER=
NEXT_PUBLIC_PAYMENT_MAYA_NAME=
NEXT_PUBLIC_PAYMENT_MAYA_NUMBER=

# ── Email sender (optional). Defaults to Resend's sandbox sender, which only
# delivers to the Resend account owner. Set this to an address on a domain you
# have verified in Resend (SPF + DKIM) before the first real cohort.
# RESEND_FROM="GN Academy <hello@yourdomain.com>"
RESEND_FROM=
